# Base URL for the backend REST API.
# Leave empty in development: the Vite dev server proxies /api to the backend.
# Set to the backend origin (e.g. https://api.gocaro.example) for production builds.
VITE_API_BASE_URL=

# Cloudflare Turnstile Site Key
VITE_TURNSTILE_SITE_KEY=

# Optional GA4 measurement ID (for example G-XXXXXXXXXX).
# Leave empty to avoid loading Google Analytics.
VITE_GA_MEASUREMENT_ID=
